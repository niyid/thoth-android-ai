<?xml version="1.0" encoding="utf-8"?>
<!--
    Prominent Disclosure Dialog Layout
    ───────────────────────────────────
    Shown BEFORE the user is directed to enable the Accessibility Service.
    Google Play requires this disclosure to explain:
      1. Why the AccessibilityService API is needed.
      2. What personal/sensitive data is collected via it.
      3. How that data is used / shared.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbarStyle="insideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Icon + Title row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Shield / privacy icon -->
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_lock_lock"
                android:contentDescription="Privacy"
                android:layout_marginEnd="12dp"
                app:tint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/tvDisclosureTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/disclosure_title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"
            android:alpha="0.3"
            android:layout_marginBottom="16dp" />

        <!-- Body text (HTML-formatted via fromHtml in code) -->
        <TextView
            android:id="@+id/tvDisclosureBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="24dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline"
            android:alpha="0.3"
            android:layout_marginBottom="16dp" />

        <!-- Buttons -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisclosureProceed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclosure_btn_proceed"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDisclosureCancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclosure_btn_cancel"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>
</ScrollView>
