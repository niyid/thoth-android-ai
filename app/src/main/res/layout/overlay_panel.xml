<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/thot_panel_background"
    android:padding="12dp"
    android:elevation="12dp">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="𓂀 Thot"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/purple_700" />

        <TextView
            android:id="@+id/tvPanelClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✕"
            android:textSize="16sp"
            android:padding="8dp"
            android:contentDescription="@string/overlay_close" />
    </LinearLayout>

    <!-- Context label -->
    <TextView
        android:id="@+id/tvContextLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="What do you need?"
        android:textSize="12sp"
        android:textColor="#888"
        android:layout_marginBottom="8dp" />

    <!-- Quick action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExplain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Explain"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSummarize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Summarize"
            android:textSize="11sp"
            android:layout_marginEnd="4dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRespond"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Respond"
            android:textSize="11sp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnWrite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✍️  Write / Draft for me"
        android:textSize="12sp"
        android:layout_marginBottom="6dp"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

    <!-- Custom task input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCustomTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Or type a custom task…"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        android:layout_marginBottom="8dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCustomTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSend"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Loading indicator -->
    <LinearLayout
        android:id="@+id/layoutLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:layout_marginBottom="8dp">

        <ProgressBar
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_thinking"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Response area -->
    <ScrollView
        android:id="@+id/scrollResponse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="200dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:padding="8dp"
            android:background="#10000000"
            android:textIsSelectable="true" />

    </ScrollView>

    <!-- Copy response button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCopyResponse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📋 Copy Response"
        android:visibility="gone"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        style="@style/Widget.MaterialComponents.Button.TextButton" />

</LinearLayout>
